# Runtime
NODE_ENV=development
PORT=3000
# Comma-separated origins. Required in production. Native apps do not rely on browser CORS,
# but this protects future web/admin clients and accidental browser exposure.
CORS_ORIGINS=http://localhost:8081
TRUST_PROXY_HOPS=1

# Supabase - server only
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Legacy fallback only:
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI - server only
AI_PROVIDER_MODE=mock
OPENAI_API_KEY=
# Admin key (sk-admin-). Only this can read the real dollar bill and prepaid credit. A project key cannot.
OPENAI_ADMIN_KEY=
OPENAI_MODEL=gpt-5.6-terra

# Live voice. The phone never sees these. It only receives a short-lived room token.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Founder/billing controls
# Comma-separated Supabase auth user IDs allowed to bootstrap Founder Admin access.
FOUNDER_USER_IDS=
# Development only. Never enable in staging/production when real billing is connected.
BILLING_DEMO_MODE=false
